# ComicCraft Environment Configuration Example
# Copy this file to .env and set your API keys if you wish to use live AI providers.

# Application Settings
DEBUG=True

# Google GenAI Settings (Official google-genai SDK)
# Get your API key from https://aistudio.google.com/
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# Supported Gemini Model IDs
GEMINI_FLASH_MODEL=gemini-2.5-flash
GEMINI_PRO_MODEL=gemini-2.5-pro

# Hugging Face Inference Settings (Optional for remote image generation)
# Get your token from https://huggingface.co/settings/tokens
HF_API_KEY=YOUR_HUGGING_FACE_TOKEN
HF_IMAGE_MODEL=runwayml/stable-diffusion-v1-5

# Fallback Configuration
# When API keys are not provided, ComicCraft runs in deterministic Offline Demo Mode.
ENABLE_OFFLINE_DEMO=True
